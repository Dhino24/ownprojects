# Yoon — variables d'environnement (aucun secret ici). Copier en .env pour le développement local.
NODE_ENV=development
APP_NAME=Yoon
PORT=8787
# URL publique de l'interface : sert aux liens clients et au contrôle d'origine.
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://yoon:yoon@localhost:5432/yoon
# Obligatoire en production : 32 caractères aléatoires minimum (openssl rand -base64 48).
APP_SECRET=
# Stockage privé des photos, vocaux et justificatifs (jamais servi en statique).
STORAGE_DIR=./storage
MEDIA_RETENTION_DAYS=90
# Règles d'attribution et de remise
OFFER_TTL_SECONDS=30
CODE_MAX_ATTEMPTS=5
CODE_TTL_HOURS=72
CLIENT_LINK_TTL_HOURS=72
SESSION_TTL_DAYS=14
# Heure (Africa/Dakar) de préparation du récapitulatif quotidien
RECAP_HOUR_DAKAR=21
# manual = liens WhatsApp préremplis envoyés par un humain. "api" n'est pas implémenté (accès à fournir).
WHATSAPP_MODE=manual
# manual = vérification humaine des transferts Wave / Orange Money (seul mode disponible).
PAYMENT_MODE=manual
# Affiche le bandeau « démonstration ». Interdit en production.
DEMO_MODE=false
JOBS_ENABLED=true
# Production : l'API sert aussi l'interface compilée (dist-web).
SERVE_WEB=false
# true derrière un reverse proxy (Nginx, Caddy…) pour l'IP réelle et la limitation de débit.
TRUST_PROXY=false
# Vite : tuiles de carte (OpenStreetMap par défaut, à remplacer par un fournisseur en production).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap
